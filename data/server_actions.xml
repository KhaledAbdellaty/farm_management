<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Repair Duplicate Analytic Entries
        Removes ghost analytic lines created by Daily Report for PO-backed
        labor/machinery lines before the duplication fix was applied.
        Accessible from Farm Management > Configuration > Tools.
    -->
    <record id="action_repair_duplicate_analytic_entries" model="ir.actions.server">
        <field name="name">Repair Duplicate Analytic Entries</field>
        <field name="model_id" ref="farm_management.model_farm_daily_report"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_repair_duplicate_analytic_entries()
        </field>
    </record>

    <!--
        Repair Invoice-Backed Analytic Duplicates
        Removes ghost analytic lines from cost analysis records whose invoice
        is already posted (bill's own analytic line is the authoritative one).
    -->
    <record id="action_repair_invoice_analytic_duplicates" model="ir.actions.server">
        <field name="name">Repair Invoice-Backed Analytic Duplicates</field>
        <field name="model_id" ref="farm_management.model_farm_cost_analysis"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_repair_invoice_analytic_duplicates()
        </field>
    </record>
</odoo>

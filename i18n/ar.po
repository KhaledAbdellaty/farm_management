#. module: farm_management
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        The stock receipt has been created. Click <strong>Validate Receipt</strong>\n"
"                        to confirm the quantity in inventory. This action cannot be undone."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\"/>\n"
"                        تم إنشاء إيصال المخزون. انقر على <strong>التحقق من الإيصال</strong>\n"
"                        لتأكيد الكمية في المخزون. لا يمكن التراجع عن هذا الإجراء."

#. module: farm_management
msgid "<i class=\"fa fa-exclamation-triangle me-2\" title=\"Warning\" aria-label=\"Warning\"/>"
msgstr "<i class=\"fa fa-exclamation-triangle me-2\" title=\"تحذير\" aria-label=\"تحذير\"/>"

#. module: farm_management
msgid ""
"<i class=\"fa fa-info-circle me-1\"/>\n"
"                                Add one row per harvest event. Fill in the date, quantity and price, then:"
